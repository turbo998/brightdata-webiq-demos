# Secrets — never commit real credentials. Use .env.example as the template.
.env
**/.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/

# Demo videos (large binaries — not part of the code)
*.mp4

# Local collected output
output/

# Repository privacy boundary: keep credentials and machine state local.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
!**/.env.*.example
**/id_rsa
**/id_ed25519
**/*.pfx
**/*.p12
**/*.tfstate
**/*.tfstate.*
