# ── Demo 4 · Web IQ side ───────────────────────────────────────────────
# Microsoft Web IQ grounding API key (from your Web IQ portal / access email).
WEBIQ_API_KEY=your-web-iq-key-here

# Endpoint + request-body knobs are optional — defaults match the v3 API.
# WEBIQ_ENDPOINT=https://api.microsoft.ai/v3/search/web

# ── Demo 4 · Bright Data side (only needed for --bd-live) ───────────────
# Reused by task2_amazon_flow/amazon_flow.py. By default the demo replays
# the most recent task2_amazon_flow/output/amazon_products_*.json instead,
# so these are only required when you pass --bd-live.
BROWSER_AUTH=brd-customer-<id>-zone-<zone>:<password>
BRIGHTDATA_API_TOKEN=<api-token>
