# ================= Bright Data demo credentials =================
# Copy this file to .env inside each demo folder that needs it, then fill in.

# --- API token (Web Scraper API, Web Unlocker API, MCP) ---
# Bright Data dashboard > account settings > API tokens
BRIGHTDATA_API_TOKEN=<your-brightdata-api-token>

# --- Browser API (Scraping Browser) zone ---
# Dashboard > Browser API zone. Format: brd-customer-<id>-zone-<zone>:<password>
BROWSER_AUTH=brd-customer-hl_xxxxxxxx-zone-scraping_browser:xxxxxxxxxxxx
BROWSER_HOST=brd.superproxy.io
BROWSER_PORT=9222

# --- Web Unlocker zone name (Demo 1) ---
# The name of your Web Unlocker zone in the dashboard (often web_unlocker1)
UNLOCKER_ZONE=web_unlocker1

# --- Web Scraper dataset (Demo 2) ---
# Amazon "Products by URL" dataset id (confirm in your dashboard)
AMAZON_DATASET_ID=gd_l7q7dkf244hwjntr0

# --- Demo knobs ---
SEARCH_KEYWORD=lenovo thinkpad
MAX_PDPS=5
# Amazon results pages to crawl (1 = first page; raise to collect ALL PDPs)
MAX_PAGES=1
